{
  "name": "loom-editor",
  "displayName": "Loom Editor",
  "description": "Editing loom's source files: errors where you type, from the loom language server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "workspaceContains:**/*display.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loom.openViewer",
        "title": "Loom: Open Viewer",
        "category": "Loom",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "loom.openViewer",
          "when": "resourceFilename =~ /(^|\\.)(display|metre|notes)\\.txt$|^meta\\.toml$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.python": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The Python that runs loom: 3.12 or newer, as a full path (for example `C:\\Python312\\python.exe` or `/opt/homebrew/bin/python3`). Leave empty to let the extension search for one. Only your user settings can set this, never a folder's own settings."
        },
        "loom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Show the messages between VS Code and the loom server in the Loom output, for diagnosing problems."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p .",
    "compile:webview": "tsc -p webview && esbuild webview/main.tsx --bundle --outfile=out/webview.js --tsconfig=webview/tsconfig.json --sourcemap"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@types/vscode-webview": "^1.57.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
