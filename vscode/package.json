{
  "name": "loom-editor",
  "displayName": "Loom Editor",
  "description": "Write loom's source files, and see the poem drawn beside them",
  "publisher": "jin-choi",
  "version": "0.1.1",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Loom Editor runs Python on the files of the open folder, so it runs only in folders you trust."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:**/*display.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loom.openViewer",
        "title": "Open Viewer",
        "category": "Loom",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "loom.openViewer",
          "when": "resourceFilename =~ /(^|\\.)(display|metre|notes)\\.txt$|^meta\\.toml$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.python": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The Python that runs loom: 3.12 or newer, as a full path (for example `C:\\Python312\\python.exe` or `/opt/homebrew/bin/python3`). Leave empty to let the extension search for one. Only your user settings can set this, never a folder's own settings."
        },
        "loom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Show the messages between VS Code and the loom server in the Loom output, for diagnosing problems."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p . && tsc -p webview",
    "compile": "npm run check && node build.mjs",
    "compile:production": "npm run check && node build.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vscode-languageclient": "^11.0.0"
  }
}
