{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bundle the server",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["scripts/bundle.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "compile the extension",
      "type": "npm",
      "script": "compile",
      "path": "vscode",
      "problemMatcher": "$tsc"
    },
    {
      "label": "build",
      "dependsOn": ["bundle the server", "compile the extension"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
