{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the Loom extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "preLaunchTask": "compile the extension"
    }
  ]
}
